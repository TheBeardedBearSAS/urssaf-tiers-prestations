<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <!-- Payment request. The invoice and the timeline are embedded as columns; collections and optional groups (lines,
         deposit, submission errors, URSSAF tracking) are JSON columns with explicit serializers. The columns the polling
         queries filter on are in the 1:1 table of PaymentRequestProgress. -->
    <entity name="TheBeardedBear\UrssafTiersPrestations\Domain\PaymentRequest\PaymentRequest" table="urssaf_tps_payment_requests">
        <unique-constraints>
            <unique-constraint name="uniq_urssaf_tps_payment_request_invoice_number" columns="tenant_id,invoice_number"/>
            <unique-constraint name="uniq_urssaf_tps_payment_request_external_reference" columns="tenant_id,external_reference"/>
        </unique-constraints>
        <indexes>
            <index name="idx_urssaf_tps_payment_request_stale" columns="state,submission_started_at"/>
        </indexes>
        <id name="id" type="urssaf_tps_local_payment_request_id" column="id" length="64">
            <generator strategy="NONE"/>
        </id>
        <field name="tenantId" type="urssaf_tps_tenant_id" column="tenant_id" length="64"/>
        <field name="externalReference" type="urssaf_tps_external_reference" column="external_reference" length="191"/>
        <field name="state" type="string" column="state" length="32" enum-type="TheBeardedBear\UrssafTiersPrestations\Domain\PaymentRequest\SubmissionState"/>
        <field name="attempts" type="integer" column="submission_attempts"/>
        <field name="submissionErrors" type="urssaf_tps_submission_errors" column="submission_errors"/>
        <field name="tracking" type="urssaf_tps_urssaf_tracking" column="tracking"/>
        <embedded name="invoice" class="TheBeardedBear\UrssafTiersPrestations\Domain\PaymentRequest\Invoice" use-column-prefix="false"/>
        <embedded name="timeline" class="TheBeardedBear\UrssafTiersPrestations\Domain\PaymentRequest\Timeline" use-column-prefix="false"/>
    </entity>
</doctrine-mapping>
