<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <embeddable name="TheBeardedBear\UrssafTiersPrestations\Domain\PaymentRequest\Timeline">
        <field name="createdAt" type="urssaf_tps_instant" column="created_at"/>
        <field name="updatedAt" type="urssaf_tps_instant" column="updated_at"/>
        <field name="submissionStartedAt" type="urssaf_tps_instant" column="submission_started_at" nullable="true"/>
        <field name="submittedAt" type="urssaf_tps_instant" column="submitted_at" nullable="true"/>
    </embeddable>
</doctrine-mapping>
