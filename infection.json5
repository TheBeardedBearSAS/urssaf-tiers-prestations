{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "phpUnit": {
        "configDir": "."
    },
    "testFrameworkOptions": "--testsuite=unit,functional",
    "tmpDir": "var/infection-tmp",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json",
        // Full mutation report of main on the Stryker Dashboard (needs STRYKER_DASHBOARD_API_KEY, set in CI only).
        "stryker": {
            "report": "/^main$/"
        }
    },
    "mutators": {
        "@default": true
    },
    // Infection *skips* (never runs) a mutant whose covering tests take longer than
    // this limit in total, and still reports MSI 100 %. Widely used value objects are covered by the functional suites,
    // so 30 s left mutants untested on slower machines (139 in the auto-entrepreneur package). A higher limit makes the gate stricter, not weaker;
    // `make infection` and the CI job also fail when any mutant is skipped.
    "timeout": 180,
    "minMsi": 100,
    "minCoveredMsi": 100
}
