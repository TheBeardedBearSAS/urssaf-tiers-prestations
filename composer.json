{
    "name": "thebeardedbear/urssaf-tiers-prestations",
    "description": "Client, domain model and Symfony/Doctrine integration for the URSSAF \"API Tiers de prestations\" (immediate tax credit advance)",
    "license": "proprietary",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/cache": "^2.0 || ^3.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "deptrac/deptrac": "^4.7",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/orm": "^3.0",
        "ergebnis/composer-normalize": "^2.56",
        "ergebnis/phpstan-rules": "^2.17",
        "friendsofphp/php-cs-fixer": "^3.95",
        "icanhazstring/composer-unused": "^0.9",
        "infection/infection": "^0.32",
        "maglnet/composer-require-checker": "^4.17",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest",
        "shipmonk/phpstan-rules": "^4.4",
        "symfony/cache": "^6.4 || ^7.4",
        "symfony/clock": "^6.4 || ^7.4",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/framework-bundle": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/lock": "^6.4 || ^7.4",
        "symfony/messenger": "^6.4 || ^7.4",
        "symfony/uid": "^6.4 || ^7.4",
        "symfony/yaml": "^6.4 || ^7.4",
        "tomasvotruba/type-coverage": "^2.5"
    },
    "conflict": {
        "doctrine/dbal": "<4.0",
        "doctrine/doctrine-bundle": "<2.19",
        "doctrine/orm": "<3.0",
        "symfony/console": "<6.4",
        "symfony/framework-bundle": "<6.4",
        "symfony/http-client": "<6.4",
        "symfony/http-kernel": "<6.4",
        "symfony/lock": "<6.4",
        "symfony/messenger": "<6.4"
    },
    "suggest": {
        "ext-intl": "Better transliteration of customer names (AsciiNameNormalizer); a built-in fallback map is used otherwise",
        "doctrine/dbal": "Required by the Doctrine bridge (custom types)",
        "doctrine/doctrine-bundle": "Required for the Doctrine bridge",
        "doctrine/orm": "Required for the Doctrine bridge",
        "nyholm/psr7": "PSR-17 factories used by the Symfony bridge default HTTP client",
        "symfony/config": "Required by the Symfony bridge (bundle configuration)",
        "symfony/console": "Provides console commands",
        "symfony/dependency-injection": "Required by the Symfony bridge",
        "symfony/framework-bundle": "Required to use the Symfony bundle",
        "symfony/http-client": "PSR-18 compatible HTTP client for the API",
        "symfony/http-kernel": "Required by the Symfony bridge (bundle)",
        "symfony/lock": "Prevents overlapping runs of the same command / handler for a tenant (see the \"lock\" bundle option)",
        "symfony/messenger": "Enables asynchronous message handling"
    },
    "autoload": {
        "psr-4": {
            "TheBeardedBear\\UrssafTiersPrestations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheBeardedBear\\UrssafTiersPrestations\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
